POSTGRES_DB=jinmemo
POSTGRES_USER=jinmemo
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://jinmemo:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@localhost:5432/jinmemo
REDIS_URL=redis://localhost:6379
PORT=4000
SITE_ADDRESS=http://localhost
# JinMemo test deployment: set PUBLIC_BASE_URL=https://jinmemo.com on the server.
# Fresh install: generate NEW database credentials, admin password and proxy secret.
PUBLIC_BASE_URL=https://jinmemo.com
# First startup creates this admin if both values are set. Use >=12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Enable only when real content, domain and policies are ready for search indexing.
SEO_INDEXING=false

# Optional: >=32 random characters shared ONLY by API and NPM for verified client IP and login metadata.
# Configure NPM X-JinMemo-Edge-Secret and X-JinMemo-Client-IP headers; see docs/PROXY-CLIENT-IP.md.
ADMIN_PROXY_SECRET=

# Clean install: no demo products, articles, bookings or payment settings.
SEED_DEMO_DATA=false
# NPM is on another server in your setup. Restrict this port to your proxy on the host firewall.
WEB_BIND=0.0.0.0
WEB_PORT=3101
